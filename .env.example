# Скопіюйте у .env або задайте змінні середовища на хостингу.
PORT=3000
# Де зберігається база (на хостингу змонтуйте сюди постійний диск!)
DATA_DIR=./data
# Якщо сайт стоїть за reverse-proxy з HTTPS (Caddy, nginx, Cloudflare, Render, Railway…):
TRUST_PROXY=1
# Необовʼязково: створити першого адміністратора автоматично (інакше буде одноразовий код у консолі).
# Після першого запуску ЗАБЕРІТЬ пароль зі змінних.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=придумайте-довгий-пароль
